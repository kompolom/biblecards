{
  "compilerOptions": {
    "outDir": "dist",
    "types": ["vite/client", "jest"],
    "target": "ESNext",
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": "./src",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "shared/*": ["shared/*"],
      "entities/*": ["entities/*"],
      "widgets/*": ["widgets/*"],
      "pages/*": ["pages/*"]
    },
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true
  }
}
